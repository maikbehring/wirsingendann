# Optional: offizielle Twitch Helix API (sonst Live-Daten via decapi.me)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=mittwaldhosting

# Persistenz (Docker-Volume)
DATA_DIR=./data

# Hinter nginx/Traefik/Cloudflare: true (sonst Rate-Limits per „direct“)
TRUST_PROXY=false

# Admin-Login (/admin) — min. 8 Zeichen
ADMIN_PASSWORD=dein-sicheres-passwort
# Optional: separates Signatur-Secret (sonst = ADMIN_PASSWORD)
ADMIN_SECRET=

# Signatur für Voter-Cookies (Production: eigenes Random-Secret setzen)
VOTER_SECRET=

# Friendly Captcha (Votes, EU) — https://friendlycaptcha.com/
# Sitekey (öffentlich) + API-Key (nur Server) aus dem Dashboard
NEXT_PUBLIC_FRIENDLY_CAPTCHA_SITE_KEY=
FRIENDLY_CAPTCHA_API_KEY=
# optional: eu (Standard) oder global
FRIENDLY_CAPTCHA_REGION=eu
